# Host ports (maps to the nginx container)
HTTP_PORT=80
HTTPS_PORT=443

# Behind your own reverse proxy that terminates TLS (#256). proxy serves the app
# over plain HTTP on HTTP_PORT instead of redirecting to HTTPS; keep that port
# reachable only by the proxy. TRUSTED_PROXIES lists the proxy's address or CIDR
# range (comma-separated) so the real client address and https scheme it
# forwards are believed. See docs/configuration.md#behind-a-reverse-proxy.
#TLS_MODE=proxy
#TRUSTED_PROXIES=10.0.0.5
# Host address to publish the web UI on. Unset = every interface (IPv4 and IPv6).
# Set it to a LAN or VPN address if the host has a public interface: Docker
# publishes ports ahead of ufw/firewalld, so a host firewall alone does not close
# them. See docs/configuration.md#network-exposure.
# BIND_ADDRESS=192.168.1.10
# The same for the NetFlow collector (UDP 2055). Unset = every interface.
# NETFLOW_BIND_ADDRESS=192.168.1.10
TZ=UTC

# IPv6 device addresses. Off by default. Needs IPv6 on the host, Docker 27+, and
# accept_ra=2 on the host's network interface. After changing it, run
# `docker compose down` then `docker compose up -d`. See docs/devices.md.
# ENABLE_IPV6=true

# Browser origins allowed to call the API (comma-separated). Required in production.
# Docker Compose defaults this for local https://localhost access; override for your domain.
# CORS_ORIGIN=https://manager.example.com,http://localhost:3000

# Internal service passwords. The defaults are public: on a new install, set
# your own before the first start (openssl rand -hex 24). On an existing
# install, change them inside the database first; see
# docs/configuration.md#internal-service-passwords.
# SSO-only sign-in: false hides username/password on the login page and turns
# off password sign-in, password changes and 2FA. Only applies while SSO is
# configured; set it back to true (and restart) if SSO ever breaks.
# PASSWORD_LOGIN=false

# Database
DB_PASSWORD=mikrotik_secure_pw
# Optional. Redis requires it once set; it can be set or changed at any time.
# REDIS_PASSWORD=

# Login signing secret and device-credential encryption key.
# Leave these blank: strong values are generated on first start and kept in the
# app_data volume. Set them only if you manage secrets yourself (JWT_SECRET at
# least 32 random characters, ENCRYPTION_KEY exactly 32). Keep a copy of the
# app_data volume with your backups; without the key, stored device passwords
# cannot be decrypted.
JWT_SECRET=
ENCRYPTION_KEY=
# Only while changing ENCRYPTION_KEY: the old key, so data under it can still be
# read and re-encrypted. Remove it once Settings -> General -> Encryption key shows nothing under
# an older key.
# ENCRYPTION_KEY_PREVIOUS=

# InfluxDB
INFLUXDB_TOKEN=mytoken123456789
INFLUXDB_ORG=mikrotik-manager
INFLUXDB_BUCKET=metrics
INFLUXDB_ADMIN_PASSWORD=admin_password_123

# ─── Poller tuning (see GET /api/system/poller) ──────────────────────────────
# Raise concurrency if `headroom` in the poller health endpoint drops near 1.0 —
# below that the queue grows every cycle and devices go stale.
# POLLER_CONCURRENCY=12
# POLLER_JOB_TIMEOUT_MS=45000
# Scheduler tick; poll intervals themselves are in Settings → Polling (and per site or device).
# POLLER_INTERVAL_MS=10000
# POLLER_JOB_RETENTION_SEC=3600
# POLLER_JOB_RETENTION_COUNT=5000
# Extra poll workers: docker compose --profile workers up -d --scale poller=3
# api = leave all polling to them; all (default) = this backend polls too.
# See docs/scaling.md#more-workers.
# POLLER_ROLE=all

# Redis memory ceiling. Eviction is disabled (noeviction) because BullMQ's locks
# and stalled-check keys carry TTLs and must never be evicted; the cap exists to
# protect the host, and retention keeps usage well below it.
# REDIS_MAXMEMORY=512mb
# Which images docker-compose.ghcr.yml runs: latest (stable, the default), beta
# (the next minor's betas), or a version such as 1.0.0 to stay on it. See
# docs/configuration.md, Release channels. Ignored by the source-build compose file.
# MTM_TAG=latest
